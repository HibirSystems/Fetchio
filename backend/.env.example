# Application
APP_NAME=Fetchio API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
ALLOWED_ORIGINS=["http://localhost:3000"]
# Optional: serve a built Flutter web app from this directory
# FRONTEND_DIR=../frontend/build/web

# Database
DATABASE_URL=sqlite+aiosqlite:///./fetchio.db

# Redis (optional – used for distributed caching)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# Downloads
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DOWNLOADS=3
MAX_FILE_SIZE_MB=2048

# yt-dlp
YTDLP_PROXY=
# Private Netscape cookies file on the BACKEND (never embed in the APK)
YTDLP_COOKIES_FILE=
# Railway alternative: base64-encoded Netscape cookies file in a private runtime variable
# Configure only one cookie source. Never put the value in this example or git.
YTDLP_COOKIES_BASE64=
YTDLP_MAX_RETRIES=3

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Security
SECRET_KEY=change-me-in-production-use-long-random-string
API_KEYS=[]
